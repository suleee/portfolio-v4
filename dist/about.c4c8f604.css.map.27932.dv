{"mappings":"AAEA;;;;;;;;;;AASA;;;;;;;;;;AASA;;;;;;;;;;AASA;;;;;;;;;;AASA;;;;AAKE;;;;;;AASA;;;;AAKF;;;;;;;;AAWA;;;;;;;AAOA;;;;;;;;;AAQA;EACE;;;;EAGA;;;;;AAKF;;;;AAEE;;;;;;AAOF;;;;;;;;;AAOE;;;;AAKF;;;;AAGA;;;;AAIA;;;;;AAGE;;;;;AAGE;;;;;AAOJ;;;;;AAQA;;;;AAME;;;;;AAMF","sources":["src/scss/about.scss","src/scss/_library.scss"],"sourcesContent":["@import \"library\";\r\n\r\n@keyframes slideIn {\r\n  0% {\r\n    transform: translateX(500px) scale(0.2);\r\n  }\r\n  100% {\r\n    transform: translateX(0px) scale(1);\r\n  }\r\n}\r\n\r\n@keyframes slideUp {\r\n  0% {\r\n    transform: translateY(2000px);\r\n  }\r\n  100% {\r\n    transform: translateY(0px);\r\n  }\r\n}\r\n\r\n@keyframes slidedDown {\r\n  0% {\r\n    transform: translateY(-100px);\r\n  }\r\n  100% {\r\n    transform: translateY(0px);\r\n  }\r\n}\r\n\r\n@keyframes expand {\r\n  0% {\r\n    transform: translateX(3000px);\r\n  }\r\n  100% {\r\n    transform: translateX(0px);\r\n  }\r\n}\r\n\r\n.herobanner {\r\n  padding-top: $space-content-top;\r\n}\r\n\r\n.profile {\r\n  img {\r\n    border-radius: 4px;\r\n    max-width: 300px;\r\n    height: auto;\r\n  }\r\n}\r\n\r\n.item-con {\r\n  // padding-bottom: $s;\r\n  img {\r\n    max-width: 150px;\r\n  }\r\n}\r\n\r\n.overlay {\r\n  position: absolute;\r\n  top: 0;\r\n  left: 0;\r\n  right: 0;\r\n  bottom: 0;\r\n  height: 100%;\r\n  z-index: -10;\r\n  background-color: $base-color;\r\n}\r\n\r\n.about-page {\r\n  animation: expand 0.8s ease forwards;\r\n  background-color: $bg-color;\r\n  position: relative;\r\n  transition: all 0.8s ease;\r\n}\r\n\r\n.menu {\r\n  width: 100%;\r\n  position: sticky;\r\n  background-color: $bg-color;\r\n  top: 0;\r\n  height: 62px;\r\n  z-index: 1;\r\n}\r\n@media (max-width: 768px) {\r\n  .menu {\r\n    height: 120px;\r\n  }\r\n  .space-bottom2 {\r\n    padding-bottom: 52px;\r\n  }\r\n}\r\n\r\n.about-page .about {\r\n  color: white;\r\n  .icon-img {\r\n    max-width: 80px;\r\n    margin: 0 auto;\r\n    padding: 24px 0;\r\n  }\r\n}\r\n\r\n.download-btn {\r\n  background-color: black;\r\n  color: white;\r\n  border-radius: 4px;\r\n  padding: 16px 20px;\r\n  text-align: center;\r\n  margin-top: 2rem;\r\n  &:hover {\r\n    background-color: $base-color;\r\n  }\r\n}\r\n\r\n.download-icon {\r\n  max-width: 28px;\r\n}\r\n.resume-btn-text {\r\n  color: white;\r\n}\r\n\r\n.footer {\r\n  padding-top: $space-content-top;\r\n  padding-bottom: $space-ending;\r\n  img {\r\n    max-width: 40px;\r\n    border-radius: 4px;\r\n    &:hover {\r\n      width: 38px;\r\n      border-radius: 4px;\r\n    }\r\n  }\r\n}\r\n\r\n.design,\r\n.career,\r\n.design-principle,\r\n.books {\r\n  padding-top: $space-content-top;\r\n  padding-bottom: $space-content-bottom;\r\n}\r\n\r\nhr {\r\n  color: #6d6866;\r\n}\r\n\r\n.design,\r\n.design-principle {\r\n  img {\r\n    max-width: 72px;\r\n    height: 72px;\r\n  }\r\n}\r\n\r\n.context {\r\n  margin: 0 auto;\r\n  padding: 0 32px;\r\n  // max-width: 350px;\r\n}\r\n",null],"names":[],"version":3,"file":"about.c4c8f604.css.map","sourceRoot":"/__parcel_source_root/"}