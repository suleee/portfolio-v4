{"mappings":"AAIA;;;;AAIA;;;;;;;;;AASA;;;;;AAKA;EACE;;;;EAGA;;;;;;AAKF;EACE;;;;;AAIF;EACE;;;;EAGA;;;;;;AAKF;EACE;;;;EAGA;;;;;;AAKF;EACE;;;;;AAMF;EACE;;;;;AAKF;;;;AAIA;;;;;;AAIE;;;;AAGA;;;;AAEE;;;;AAIF;;;;;;;AAKE;;;;;AAOJ;;;;AAIA;;;;;AAMA;;;;;AAaA;;;;;AAKA;;;;;AAKA;;;;AAUA;;;;;;;;;AASA;;;;;;AAKA;;;;;;AAMA;;;;;;;;AAME;;;;AAKF;;;;;;;;;AASA;;;;;;;;;AASA;;;;;;;;AAQA;;;;;;;;;AASA;;;;;AAIA;;;;AAIA;;;;;AAKA;;;;AAIA;;;;;AAKA;;;;AAIA;;;;AAIA;;;;AAIA;;;;AAKA;;;;AAIA;;;;AAIA;;;;;AAGE;;;;;AAGE;;;;AAKF;;;;AAKF;;;;AAEE;;;;;AAIA;;;;AAEE;;;;AAIF;;;;AAGA","sources":["src/scss/payshepherd.scss","src/scss/_library.scss"],"sourcesContent":["@import \"library\";\r\n\r\n$payshepherd-color: #286cb2;\r\n\r\n.herobanner-bg {\r\n  background-color: #f5f5f5;\r\n}\r\n\r\n.herobanner {\r\n  background-image: url(\"../images/payshepherd/p-herobanner3.jpg\");\r\n  background-size: cover;\r\n  background-position: center;\r\n  background-repeat: no-repeat;\r\n  width: 100%;\r\n  height: 500px;  \r\n}\r\n\r\nvideo {\r\n  width: 700px;\r\n  height: 500px;\r\n}\r\n\r\n@media (min-width: 0px) {\r\n  .herobanner {\r\n    max-height: 280px; /* Adjust the height for larger screens */\r\n  }\r\n  video {\r\n    width: 300px;\r\n    height: 100%;\r\n  }\r\n}\r\n@media (min-width: 350px) {\r\n  .herobanner {\r\n    max-height: 350px; /* Adjust the height for larger screens */\r\n  }\r\n}\r\n@media (min-width: 768px) {\r\n  .herobanner {\r\n    max-height: 300px; /* Adjust the height for larger screens */\r\n  }\r\n  video {\r\n    width: 700px;\r\n    height: 100%;\r\n  }\r\n}\r\n@media (min-width: 900px) {\r\n  .herobanner {\r\n    max-height: 450px; /* Adjust the height for larger screens */\r\n  }\r\n  video {\r\n    width: 800px;\r\n    height: 100%;\r\n  }\r\n}\r\n@media (min-width: 1400px) {\r\n  .herobanner { \r\n    // width: 70%;\r\n    max-height: 600px; /* Adjust the height for larger screens */\r\n  }\r\n}\r\n\r\n@media (max-width: 768px) {\r\n  .typeface1 h3 {\r\n    font-size: 1.5rem !important;\r\n  }\r\n}\r\n\r\nh2 {\r\n  padding-bottom: $space-title-bottom;\r\n}\r\n\r\n.menu {\r\n  height: 64px;\r\n  padding-top: 16px;\r\n  background-color: white;\r\n  h1 { \r\n    font-size: 24px;\r\n  }\r\n  .works {\r\n    color: black;\r\n    &:hover {\r\n      color: $base-color;\r\n    }\r\n  }\r\n  .contact {\r\n    background-color: black;\r\n    padding: 10px;\r\n    color: white;\r\n    border-radius: 4px;\r\n    &:hover {\r\n      background-color: $base-color;\r\n      color: white;\r\n    }\r\n  }\r\n}\r\n\r\n.bg1 {\r\n  background-color: #fcf9f2;\r\n}\r\n\r\nhr {\r\n  border-top: 1px solid $grey-stroke;\r\n  margin-bottom: $space-subtitle-bottom;\r\n  // padding-top: $space-content-bottom;\r\n}\r\n\r\n.intro,\r\n.challenge,\r\n.research,\r\n.problem,\r\n.solution,\r\n.ui,\r\n.solved,\r\n.ending,\r\n.architect {\r\n  padding-top: $space-content-top;\r\n  padding-bottom: $space-content-bottom;\r\n}\r\n\r\n.learning-text-con {\r\n  background-color: #0f253a;\r\n  padding: 40px 0;\r\n}\r\n\r\n.learning-text {\r\n  color: white;\r\n  max-width: 700px;\r\n}\r\n\r\n.learning-img-con {\r\n  background: linear-gradient(\r\n    to top,\r\n    #f3f3f3,\r\n    #f3f3f3 50%,\r\n    #f3f3f3 61%,\r\n    #0f253a 61%\r\n  );\r\n}\r\n\r\n.problem2-panel {\r\n  border-radius: 10px;\r\n  background-color: #f3f3f3;\r\n  filter: drop-shadow(0 2px 3px rgb(0, 0, 0, 0.25));\r\n  padding: $space-panel;\r\n  margin-top: 16px;\r\n  margin-bottom: 16px;\r\n}\r\n\r\n.problem .list {\r\n  margin: 0;\r\n  padding: 0;\r\n  list-style-type: none;\r\n}\r\n.wrong-icon {\r\n  height: 18px;\r\n  margin: 0;\r\n  padding: 0;\r\n}\r\n\r\n.c-logo {\r\n  border: 1px solid rgb(237, 237, 237);\r\n  border-radius: 4px;\r\n  padding: 14px 0 16px 0;\r\n  width: 100px;\r\n  height: 64px;\r\n  img {\r\n    width: 100%;\r\n  }\r\n}\r\n\r\n.panel-bg {\r\n  border-radius: 10px;\r\n  background-color: white;\r\n  filter: drop-shadow(0 3px 4px rgb(0, 0, 0, 0.1));\r\n  padding: $space-panel;\r\n  margin-top: 16px;\r\n  margin-bottom: 16px;\r\n}\r\n\r\n.primary-btn {\r\n  background-color: $payshepherd-color;\r\n  border-radius: 4px;\r\n  text-align: center;\r\n  height: 40px;\r\n  padding: 4px;\r\n  color: white;\r\n}\r\n\r\n.secondary-btn {\r\n  border: 1px solid $grey-stroke;\r\n  border-radius: 4px;\r\n  height: 40px;\r\n  padding: 4px;\r\n  text-align: center;\r\n}\r\n\r\n.third-btn {\r\n  background-color: #00a624;\r\n  border-radius: 4px;\r\n  text-align: center;\r\n  height: 40px;\r\n  padding: 4px;\r\n  color: white;\r\n}\r\n\r\n.link {\r\n  color: $payshepherd-color;\r\n  font-weight: 600;\r\n}\r\n.figma-link {\r\n  color: $payshepherd-color;\r\n}\r\n\r\n.icon-title {\r\n  font-size: 0.8rem;\r\n  font-weight: 600;\r\n}\r\n\r\n.space-top {\r\n  padding-top: $space-content-top;\r\n}\r\n\r\n.space {\r\n  padding-top: $space-content-top;\r\n  padding-bottom: $space-content-bottom;\r\n}\r\n\r\n.solved .space-bottom {\r\n  padding-bottom: $space-content-bottom;\r\n}\r\n\r\nspan {\r\n  font-weight: 500;\r\n}\r\n\r\n.intro h6,\r\n.solved h6 {\r\n  padding-top: 32px;\r\n}\r\nå\r\n.button hr {\r\n  margin-top: 24px;\r\n}\r\n\r\n.btn-row {\r\n  padding: 0 24px;\r\n}\r\n\r\n.icons h6 {\r\n  padding-bottom: 16px;\r\n}\r\n\r\n.icon-con {\r\n  border-radius: 4px;\r\n  border: 1px solid $grey-stroke;\r\n  .icon {\r\n    padding: 8px;\r\n    text-align: center;\r\n    img {\r\n      max-width: 18px;\r\n      // max-height: 16px;\r\n    }\r\n  }\r\n  .right-border {\r\n    border-right: 1px solid $grey-stroke;\r\n  }\r\n}\r\n\r\n.footer {\r\n  padding-bottom: $space-ending;\r\n  img {\r\n    max-width: 28px;\r\n    border-radius: 4px;\r\n  }\r\n  a {\r\n    color: black;\r\n    &:hover {\r\n      color: $base-color;\r\n    }\r\n  }\r\n  .email-address {\r\n    margin-bottom: 36px;\r\n  }\r\n  .link-to-project {\r\n    padding: 8px;\r\n  }\r\n}\r\n",null],"names":[],"version":3,"file":"payshepherd.6e38b1bb.css.map","sourceRoot":"/__parcel_source_root/"}