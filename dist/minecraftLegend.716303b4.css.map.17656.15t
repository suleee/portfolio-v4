{"mappings":"AAEA;;;;AAaA;;;;AASA;;;;;;;;;;;;AAaA;;;;;;;;;AASA;EACE;;;;;AAIF;EACE;;;;;AAIF;EACE;;;;;AAIF;EACE;;;;;AAIF;EACE;;;;;AAIF;EACE;;;;;AAIF;EACE;;;;;AAOF;;;;;;;AAOA;;;;;;;;;AASA;;;;AAIA;;;;;;;AAOA;;;;AAIA;;;;AAGE;;;;AAKF;;;;;;AAMA;;;;;;AAOA;;;;;AAqBA;;;;;AAKA;;;;;AAME;;;;AAIA;;;;AAKF;;;;;AAKA;;;;AAIA;;;;;;AAMA;;;;AAIA;;;;AAIA;;;;AAME;;;;AAGA;;;;AAMA;;;;AAKF;;;;;;;AAKE;;;;;AAIA;;;;AAEE;;;;AAIF;;;;;;;AAKE;;;;;AAOJ;;;;;;;AAKE;;;;;AAIA;;;;AAEE;;;;AAIF;;;;AAGA;;;;;AAMF;;;;;AAIE","sources":["src/scss/ml.scss","src/scss/_library.scss"],"sourcesContent":["@import \"library\";\r\n\r\nh1,\r\nh2,\r\nh3,\r\nh4,\r\nh5,\r\nh6,\r\np,\r\nol,\r\nul,\r\nli {\r\n  color: white;\r\n}\r\n\r\n.herobanner-bg {\r\n  background-image: linear-gradient(\r\n    #0b0b17,\r\n    #090f22 65%,\r\n    #281c26 98%,\r\n    #0c0d14 10%\r\n  );\r\n} \r\n\r\n.herobanner {\r\n  background-image: url(\"../images/ml/ml-herobanner.jpg\");\r\n  background-size: cover;\r\n  background-position: center;\r\n  background-repeat: no-repeat;\r\n  width: 100%;\r\n  height: 800px; /* Adjust the initial height as needed */\r\n  text-align: center;\r\n  // display: flex;\r\n  justify-content: center;\r\n  align-items: center;\r\n}\r\n\r\n.ending {\r\n  background-image: url(\"../images/ml/ml-footer.png\");\r\n  min-height: 500px;\r\n  max-height: 620px;\r\n  background-repeat: no-repeat;\r\n  background-size: cover;\r\n  background-position: center;\r\n}\r\n\r\n@media (min-width: 0px) {\r\n  .herobanner {\r\n    max-height: 280px; /* Adjust the height for larger screens */\r\n  }\r\n}\r\n@media (min-width: 350px) {\r\n  .herobanner {\r\n    max-height: 300px; /* Adjust the height for larger screens */\r\n  }\r\n}\r\n@media (min-width: 500px) {\r\n  .herobanner {\r\n    max-height: 400px; /* Adjust the height for larger screens */\r\n  }\r\n}\r\n@media (min-width: 768px) {\r\n  .herobanner {\r\n    max-height: 550px; /* Adjust the height for larger screens */\r\n  }\r\n}\r\n@media (min-width: 900px) {\r\n  .herobanner {\r\n    max-height: 700px; /* Adjust the height for larger screens */\r\n  }\r\n}\r\n@media (min-width: 1200px) {\r\n  .herobanner {\r\n    max-height: 900px; /* Adjust the height for larger screens */\r\n  }\r\n}\r\n@media (min-width: 1400px) {\r\n  .herobanner {\r\n    // width: 80%;\r\n    margin: 0 auto;\r\n    // max-height: 1500px; /* Adjust the height for larger screens */\r\n  }\r\n}\r\n\r\n.bg1 {\r\n  background-color: #0e0d13;\r\n  background-image: url(\"../images/ml/bg-pattern.jpg\");\r\n  background-position: center;\r\n  background-repeat: repeat;\r\n}\r\n\r\n.bg2 {\r\n  background-color: #0e0d13;\r\n  background-image: url(\"../images/ml/ml-bg.jpg\");\r\n  background-position: center;\r\n  background-repeat: no-repeat;\r\n  height: 100%;\r\n  background-size: cover;\r\n}\r\n\r\n.bg3 {\r\n  background-color: rgba(7, 7, 9, 0.5);\r\n}\r\n\r\nhr {\r\n  border: none;\r\n  border-top: 3px dashed rgb(152, 152, 152);\r\n  margin-bottom: $space-title-bottom;\r\n  margin-top: $space-title-bottom;\r\n}\r\n\r\n.solution-bg {\r\n  background-color: #17171b;\r\n}\r\n\r\n.problem-bg,\r\n.solution-bg {\r\n  padding: 2rem;\r\n  li {\r\n    list-style-type: square;\r\n  }\r\n}\r\n\r\n.list {\r\n  margin: 0;\r\n  padding: 0;\r\n  list-style-type: none;\r\n}\r\n\r\n.checkmark {\r\n  background: url(\"../images/ml/icon-check.jpg\") no-repeat left top;\r\n  //   height: 80px;\r\n  padding-left: 44px;\r\n  padding-bottom: 24px;\r\n}\r\n\r\n.intro,\r\n.problem-solution,\r\n.challenges,\r\n.userflow,\r\n.wireframe,\r\n.userflow2,\r\n.breakdown,\r\n.solved,\r\n.bedrock,\r\n.engagement,\r\n.extra,\r\n.UI,\r\n.testing,\r\n.qa,\r\n.final-work,\r\n.ux,\r\n.final{\r\n  padding-top: $space-content-top;\r\n  padding-bottom: $space-content-bottom;\r\n}\r\n\r\n.summary {\r\n  padding-top: $space-content-top;\r\n  padding-bottom: 120px;\r\n}\r\n\r\n.research {\r\n  margin-top: $space-content-top;\r\n  margin-bottom: $space-content-bottom;\r\n}\r\n\r\n.summary {\r\n  p,\r\n  h5 {\r\n    margin-bottom: 0;\r\n  }\r\n  img {\r\n    width: 140%;\r\n  }\r\n}\r\n\r\nh2 {\r\n  padding-bottom: $space-subtitle-bottom;\r\n  margin-bottom: 0;\r\n}\r\n\r\nh4 {\r\n  padding-bottom: $space-subtitle-bottom;\r\n}\r\n\r\n.thought-sm-con {\r\n  background-color: #1c1a23;\r\n  padding: $space-subtitle-bottom;\r\n  margin: $space-title-bottom 0;\r\n}\r\n\r\n.space {\r\n  padding-top: 36px;\r\n}\r\n\r\n.span-grey {\r\n  color: $grey-text;\r\n}\r\n\r\n.span-bold {\r\n  font-weight: 400;\r\n}\r\n\r\n\r\n.challenges {\r\n  li {\r\n    padding-bottom: 10px;\r\n  }\r\n  h4 {\r\n    padding-bottom: 0;\r\n  }\r\n}\r\n\r\n.UI {\r\n  .font-img {\r\n    width: 74%;\r\n  }\r\n} \r\n\r\n.menu {\r\n  height: 52px;\r\n  padding-top: 16px;\r\n  position: absolute;\r\n  width: 100%;\r\n  h1 {\r\n    color: white; \r\n    font-size: 24px;\r\n  }\r\n  .works {\r\n    color: white;\r\n    &:hover {\r\n      color: $base-color;\r\n    }\r\n  }\r\n  .contact {\r\n    background-color: white;\r\n    padding: 8px;\r\n    color: black;\r\n    border-radius: 4px;\r\n    &:hover {\r\n      background-color: $base-color;\r\n      color: white;\r\n    }\r\n  }\r\n}\r\n\r\n.footer {\r\n  border-top: 1px solid #005bc0;\r\n  padding-top: $space-content-top;\r\n  padding-bottom: $space-ending;\r\n  background-color: #0172f0;\r\n  img {\r\n    max-width: 28px;\r\n    border-radius: 4px;\r\n  }\r\n  a {\r\n    color: white;\r\n    &:hover {\r\n      color: $base-color;\r\n    }\r\n  }\r\n  .email-address {\r\n    margin-bottom: 36px;\r\n  }\r\n  .link-to-project {\r\n    // text-decoration: underline;\r\n    color: white;\r\n    padding: 8px;\r\n  }\r\n}\r\n.link{\r\n  // color:#00a6ff;\r\n  color: white;\r\n  text-decoration: underline;\r\n  &:hover{\r\n    color:#00a6ff;\r\n  }\r\n }",null],"names":[],"version":3,"file":"minecraftLegend.716303b4.css.map","sourceRoot":"/__parcel_source_root/"}