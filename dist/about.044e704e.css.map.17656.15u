{"mappings":";AAKA;;;;AAKA;;;;AAKA;;;;;;AAQA;;;;;AAeA;;;;AAIA;;;;AAIA;;;;AAIA;;;;AAIA;;;;AAIA;;;;AAOA;;;;;AAKA;;;;AAIA;;;;AAIA;;;;AAEE;;;;;;AAOF;;;;;;AAMA;;;;;;;;;;;;;;;;AAgBA;;;;AAIA;;;;AAIA;;;;;AAKA;;;;AAIA;;;;AAIA;;;;AAIA;;;;AAIA;;;;AAIA;;;;AAIA;;;;AAKA;;;;;AAKA;;;;;;;;;;AAWA;;;;;;;AAOA;;;;AAIA;;;;;AAKA;;;;AAIA","sources":["src/scss/styles.scss","src/scss/_library.scss"],"sourcesContent":["@import \"library\";\r\n// @import url(\"https://fonts.googleapis.com/css2?family=Cinzel+Decorative:wght@400;700;900&family=Marcellus+SC&family=Montserrat:wght@200;400;500;700;800&family=Noto+Sans:wght@100;200;500;700&family=Playfair+Display:wght@400;700&family=VT323&display=swap\");\r\n\r\n@import url(\"https://fonts.googleapis.com/css2?family=Marcellus+SC&family=Montserrat:wght@200;400;500;700;800&family=Open+Sans:wght@300;400;500;600;700;800&family=Playfair+Display:wght@400;700&family=Roboto:wght@100;400;500;700;900&display=swap\");\r\n\r\nbody,\r\nhtml {\r\n  height: 100%;\r\n}\r\n\r\nhtml {\r\n  font-size: 100%; /*16px*/\r\n  // font-size: 112.5%; /*18px*/\r\n}\r\n\r\nbody {\r\n  // font-family: \"Montserrat\", sans-serif;\r\n  // font-family: \"Roboto\", sans-serif;\r\n  font-family: \"Open Sans\", sans-serif;\r\n  line-height: 1.75;\r\n  font-weight: 400;\r\n}\r\n\r\nh1,\r\nh2,\r\nh3,\r\nh4,\r\nh5,\r\nh6 {\r\n  font-weight: 600;\r\n  line-height: 1.3;\r\n}\r\n\r\nh6 {\r\n  font-weight: 600;\r\n  line-height: 1.3;\r\n}\r\n\r\nh1 {\r\n  // font-size: 4.768rem; //76.29px\r\n  font-size: 3.052rem; //48.83px\r\n}\r\nh2 {\r\n  font-size: 2.441rem; //39.06px\r\n}\r\n\r\nh3 {\r\n  font-size: 1.953rem; //31.35px\r\n}\r\n\r\nh4 {\r\n  font-size: 1.563rem; //25px\r\n}\r\n\r\nh5 {\r\n  font-size: 1.25rem; //20px\r\n}\r\n\r\np,\r\nli,\r\nul,\r\nol {\r\n  font-size: 1rem;\r\n}\r\n\r\np {\r\n  padding: 0;\r\n  margin: 0;\r\n}\r\n\r\n.sm-text {\r\n  font-size: 0.8rem;\r\n}\r\n\r\n.header h1 {\r\n  font-weight: bold;\r\n}\r\n\r\n.footer {\r\n  padding-top: 30px;\r\n  h1 {\r\n    font-family: \"Playfair Display\", serif;\r\n    font-size: 24;\r\n    font-weight: 700;\r\n  }\r\n}\r\n\r\nimg {\r\n  width: 100%; /* or any custom size */\r\n  height: 100%;\r\n  object-fit: contain;\r\n}\r\n\r\n#myBtn {\r\n  display: none;\r\n  position: fixed;\r\n  bottom: 20px;\r\n  right: 30px;\r\n  z-index: 99;\r\n  font-size: 18px;\r\n  border: none;\r\n  outline: none;\r\n  background-color: black;\r\n  color: white;\r\n  cursor: pointer;\r\n  padding: 15px;\r\n  border-radius: 4px;\r\n}\r\n\r\n#myBtn:hover {\r\n  background-color: $base-color;\r\n}\r\n\r\n.email-a {\r\n  color: $base-color;\r\n}\r\n\r\na {\r\n  text-decoration: none;\r\n  color: black;\r\n}\r\n\r\na:hover {\r\n  color: $base-color;\r\n}\r\n\r\n.bold {\r\n  font-weight: 400;\r\n}\r\n\r\n.space-top {\r\n  margin-top: 32px;\r\n}\r\n\r\n.space-xs-bottom {\r\n  margin-bottom: 8px;\r\n}\r\n\r\n.space-sm-bottom {\r\n  margin-bottom: 32px;\r\n}\r\n\r\n.space-bottom {\r\n  padding-bottom: 52px;\r\n}\r\n\r\n.space-lg-bottom {\r\n  padding-bottom: 72px;\r\n}\r\n\r\n// dropdown menu for works\r\n.dropdown {\r\n  position: relative;\r\n  display: inline-block;\r\n}\r\n\r\n.dropdown-content {\r\n  display: none;\r\n  position: absolute;\r\n  left: -100px;\r\n  background-color: #f1f1f1;\r\n  min-width: 250px;\r\n  box-shadow: 0px 4px 10px 0px rgba(0, 0, 0, 0.2);\r\n  z-index: 1;\r\n  // text-align: left;\r\n}\r\n\r\n.dropdown-content a {\r\n  color: black;\r\n  padding: 12px 16px;\r\n  text-decoration: none;\r\n  display: block;\r\n}\r\n\r\n.dropbtn {\r\n  cursor: pointer;\r\n}\r\n\r\n.dropdown-content a:hover {\r\n  background-color: $base-color;\r\n  color: white;\r\n}\r\n\r\n.dropdown:hover .dropdown-content {\r\n  display: block;\r\n}\r\n\r\n.left-menu {\r\n  color: white;\r\n  position: sticky;\r\n  top: 0;\r\n}\r\n",null],"names":[],"version":3,"file":"about.044e704e.css.map","sourceRoot":"/__parcel_source_root/"}