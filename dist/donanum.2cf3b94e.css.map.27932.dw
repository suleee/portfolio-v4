{"mappings":"AAGA;;;;AAIA;;;;;;;;;;;;AAaA;EACE;;;;;AAIF;EACE;;;;;AAIF;EACE;;;;;AAIF;EACE;;;;;AAIF;EACE;;;;;AAWF;;;;;AAaA;;;;AAKI;;;;;AAIA;;;;AAKJ;;;;AAIE;;;;;;AAIE;;;;AAKE;;;;AAIF;;;;;;;AAKE;;;;AAOJ;;;;;AAQA;;;;;AAKA;;;;AAIA;;;;;AAMA;;;;AAIA;;;;AAKA;;;;AAIA;;;;;AAGE;;;;;AAGE;;;;AAKF;;;;AAKF;;;;AAEE;;;;;AAIA;;;;AAEE;;;;AAIF;;;;AAGA","sources":["src/scss/donanum.scss","src/scss/_library.scss"],"sourcesContent":["@import \"library\";\r\n\r\n \r\n.herobanner-bg {\r\n  background-color: #f5f5f5;\r\n}\r\n\r\n.herobanner {\r\n  background-image: url(\"../images/donanum/donanum-herobanner.jpg\");\r\n  background-size: cover;\r\n  background-position: center;\r\n  background-repeat: no-repeat;\r\n  width: 100%;\r\n  height: 500px; /* Adjust the initial height as needed */\r\n  text-align: center; \r\n  justify-content: center;\r\n  align-items: center;\r\n}\r\n \r\n\r\n@media (min-width: 0px) {\r\n  .herobanner {\r\n    max-height: 280px; /* Adjust the height for larger screens */\r\n  } \r\n}\r\n@media (min-width: 350px) {\r\n  .herobanner {\r\n    max-height: 350px; /* Adjust the height for larger screens */\r\n  }\r\n}\r\n@media (min-width: 768px) {\r\n  .herobanner {\r\n    max-height: 300px; /* Adjust the height for larger screens */\r\n  } \r\n}\r\n@media (min-width: 900px) {\r\n  .herobanner {\r\n    max-height: 450px; /* Adjust the height for larger screens */\r\n  } \r\n}\r\n@media (min-width: 1400px) {\r\n  .herobanner {\r\n    // margin: 0 auto; \r\n    max-height: 600px; /* Adjust the height for larger screens */\r\n  }\r\n}\r\n\r\nhr {\r\n    border-top: 1px solid $grey-stroke;\r\n    margin-bottom: $space-subtitle-bottom; \r\n  }\r\n  \r\n.intro, \r\n.goal, \r\n.problem, \r\n.timeline,\r\n.keyword,\r\n.persona,\r\n.flow,\r\n.wireframe, \r\n.final {  \r\n      padding-top: $space-content-top;\r\n      padding-bottom: $space-content-bottom;\r\n  }\r\n  \r\n.persona, .goal{\r\n  background-color:   #eef1f5;\r\n}\r\n\r\n.problem {\r\n    .img-con{\r\n        display: flex;\r\n        justify-content: center;\r\n    }\r\n    img{\r\n    max-width: 80px;\r\n}\r\n}\r\n\r\nh2 {\r\n    padding-bottom: $space-title-bottom;\r\n  }\r\n  \r\n  .menu {\r\n    position: absolute;\r\n    width: 100%;\r\n    padding-top: 16px; \r\n    h1 { \r\n      font-size: 24px;\r\n    }\r\n    .works {\r\n    //   color: white;\r\n      &:hover {\r\n        color: $base-color;\r\n      }\r\n    }\r\n    .contact {\r\n      background-color: white;\r\n      padding: 10px;\r\n      color: black;\r\n      border-radius: 4px;\r\n      &:hover {\r\n        background-color: $base-color;\r\n      //   color: white;\r\n      }\r\n    }\r\n  }\r\n  \r\n  hr {\r\n    border-top: 1px solid $grey-stroke;\r\n    margin-bottom: $space-subtitle-bottom;\r\n    // padding-top: $space-content-bottom;\r\n  }\r\n \r\n \r\n    \r\n  .icon-title {\r\n    font-size: 0.8rem;\r\n    font-weight: 600;\r\n  }\r\n  \r\n  .space-top {\r\n    padding-top: $space-content-top;\r\n  }\r\n  \r\n  .space {\r\n    padding-top: $space-content-top;\r\n    padding-bottom: $space-content-bottom;\r\n  }\r\n   \r\n  \r\n  span {\r\n    font-weight: 500;\r\n  }\r\n  \r\n  .intro h6,\r\n  .solved h6 {\r\n    padding-top: 32px;\r\n  }\r\n  \r\n  .icons h6 {\r\n    padding-bottom: 16px;\r\n  }\r\n  \r\n  .icon-con {\r\n    border-radius: 4px;\r\n    border: 1px solid $grey-stroke;\r\n    .icon {\r\n      padding: 8px;\r\n      text-align: center;\r\n      img {\r\n        max-width: 18px;\r\n        // max-height: 16px;\r\n      }\r\n    }\r\n    .right-border {\r\n      border-right: 1px solid $grey-stroke;\r\n    }\r\n  }\r\n  \r\n  .footer {\r\n    padding-bottom: $space-ending;\r\n    img {\r\n      max-width: 28px;\r\n      border-radius: 4px;\r\n    }\r\n    a {\r\n      color: black;\r\n      &:hover {\r\n        color: $base-color;\r\n      }\r\n    }\r\n    .email-address {\r\n      margin-bottom: 36px;\r\n    }\r\n    .link-to-project {\r\n      padding: 8px;\r\n    }\r\n  }\r\n  ",null],"names":[],"version":3,"file":"donanum.2cf3b94e.css.map","sourceRoot":"/__parcel_source_root/"}